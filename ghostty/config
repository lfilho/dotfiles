#############
# Keybindings
#############

# Navigation
## Outside Neovim.
### Move
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right

### Resize
keybind = performable:alt+h=resize_split:left,10
keybind = performable:alt+j=resize_split:down,10
keybind = performable:alt+k=resize_split:up,10
keybind = performable:alt+l=resize_split:right,10

## Inside Neovim.
keybind = nvim/
### Move
keybind = nvim/ctrl+h=text:\x08
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c

### Resize
keybind = nvim/alt+h=esc:h
keybind = nvim/alt+j=esc:j
keybind = nvim/alt+k=esc:k
keybind = nvim/alt+l=esc:l

# Other
keybind = global:cmd+opt+j=new_window
keybind = global:ctrl+grave_accent=toggle_quick_terminal

keybind = cmd+shift+k=text:ai_cmd_helper\n

###############
# Notifications
###############

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 2s

#######
# Other
#######

auto-update = check
mouse-hide-while-typing = true
keybind = shift+enter=text:\n
cursor-click-to-move = true
shell-integration-features = sudo, title, ssh-env, ssh-terminfo
